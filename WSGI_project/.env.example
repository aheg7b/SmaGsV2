# Copy this file to .env and fill in real values. .env is gitignored.

# Database file path (relative to WSGI_project/)
DB_PATH=smags.db

# OpenRouter — required for LLM advisor. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# Local forecast coordinates (defaults to Columbia, MO)
SMAGS_LAT=38.95
SMAGS_LON=-92.33
